# =============================================================================
# usa-errands-api — Environment Variables
# =============================================================================
# Copy to `.env` for local dev. NEVER commit `.env`.
# Validated at process start by src/common/config.ts. Missing/malformed = boot halt.

NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://usaerrands:devpassword@localhost:5432/usaerrands?schema=public

# -----------------------------------------------------------------------------
# Redis (cache + BullMQ in P2+)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth — JWT signing
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-me-with-64-byte-random-base64
JWT_REFRESH_SECRET=replace-me-with-different-64-byte-random-base64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
STEP_UP_THRESHOLD_CENTS=50000

# -----------------------------------------------------------------------------
# Encryption — for MFA secrets, KYC docs, vendor banking metadata
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_MASTER_KEY=replace-me-with-32-byte-random-base64

# -----------------------------------------------------------------------------
# Cookies
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Cookie name for the refresh token (httpOnly, Secure, SameSite=Strict).
COOKIE_REFRESH_NAME=ue_rt

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=120

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development

# -----------------------------------------------------------------------------
# Stripe — payments (wallet funding + Personal Shopper checkout)
# -----------------------------------------------------------------------------
# Required in production. Get from https://dashboard.stripe.com/apikeys.
# The webhook secret is per-endpoint; create the endpoint in the dashboard
# and copy the signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# EasyPost — fulfillment carrier integration
# -----------------------------------------------------------------------------
# Required in production. The tracking webhook verifies HMAC against this.
EASYPOST_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email — transactional sending
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER:
#   "console" — logs the rendered message to the pino logger (dev/test default)
#   "resend"  — posts to https://api.resend.com/emails using RESEND_API_KEY
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="USA Errands <noreply@myusaerrands.com>"
EMAIL_REPLY_TO=support@myusaerrands.com

# -----------------------------------------------------------------------------
# Cloudflare R2 — Personal Shopper attachment uploads
# -----------------------------------------------------------------------------
# All five values must be set together (or none — the upload endpoints will
# return a structured 503 with code `r2_not_configured` if missing).
#
# 1. Account ID: https://dash.cloudflare.com → R2 → "Account details"
# 2. Create a bucket (e.g. `usa-errands-shopper-uploads`)
# 3. R2 → Manage API Tokens → Create API token with Object Read & Write
#    on that bucket only. Save the Access Key ID + Secret Access Key.
# 4. Public URL: either the bucket's r2.dev preview URL, or a Cloudflare
#    custom domain pointed at the bucket. NO trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
