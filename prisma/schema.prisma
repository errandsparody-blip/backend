// =============================================================================
// USA Errands — Prisma schema
// P0 (Foundations): users, sessions, recovery codes, audit log, configuration.
// P1 (Inventory):   vendors, products, skus, psns, psn_lines, packaging,
//                   inventory_movements, idempotency_keys.
// P2+ append: wallets/ledger, orders, returns, reassessment.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  VENDOR
  VENDOR_SUB_USER
  WAREHOUSE_OPERATOR
  FINANCE_ADMIN
  // Migration 0039 — general-purpose admin whose page-level access is
  // dynamic. SUPER_ADMIN edits `admin_role_page_permissions` (a
  // configuration row) to grant or revoke individual admin pages. The
  // page-permission guard checks that row for ADMIN users; SUPER_ADMIN
  // always passes; other roles retain their compiled-in permission
  // sets. See common/schemas/page-permissions.ts for the canonical
  // page-key list.
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  PENDING                  // not yet started
  IN_PROGRESS              // submitted, third-party verifying
  REQUIRES_RESUBMISSION    // failed, vendor must redo
  APPROVED
  REJECTED
  EXPIRED
}

enum VendorStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  CLOSED
}

// =============================================================================
// KYC v2 — structured-data enums. Phase 1 of the expanded onboarding form;
// uploads (ID front/back + selfie + business doc) land in a follow-up. Every
// vendor column backed by these enums is NULLABLE so existing vendors keep
// working without a forced re-KYC. See migration 0030 for the DB definitions.
// =============================================================================

enum KycBusinessType {
  SOLE_PROPRIETORSHIP
  REGISTERED_BUSINESS
  LLC
  CORPORATION
  PARTNERSHIP
  OTHER
}

enum KycIndustry {
  FASHION_APPAREL
  BEAUTY_COSMETICS
  HAIR_WIGS
  ELECTRONICS
  ACCESSORIES
  HOME_GOODS
  OTHER
}

enum KycIdType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
}

enum KycInventoryVolume {
  SMALL_1_10
  MEDIUM_11_30
  LARGE_31_100
  XLARGE_100_PLUS
  BULK_PALLET
}

enum KycOrderVolume {
  V_1_20
  V_21_100
  V_101_500
  V_500_PLUS
}

// Note: KycServiceIntent enum was dropped in migration 0031 — vendors are no
// longer asked which service track they intend to use during KYC.

// Note: KycFundingMethod (and the Section 7 / Section 8 columns) were
// intentionally dropped from KYC v2 Phase 1. If they ever come back, add the
// enum here and the matching columns in a new migration.

enum StorageTier {
  SMALL
  MEDIUM
  LARGE
  X_LARGE
  PALLET
}

// Migration 0033 — explicit PSN shipping mode. Before this, "loose vs
// pallet" was a frontend-only concept and the backend inferred pallet-mode
// from `declared_box_counts.PALLET > 0`. ADD_TO_PALLET ships with the same
// declared shape as LOOSE (box tiers, no PALLET key) so the mode has to
// be carried explicitly. See the migration for full semantics.
enum ShippingMode {
  LOOSE
  PALLET
  ADD_TO_PALLET
}

enum SkuStatus {
  ACTIVE
  RESERVED
  DAMAGED
  QUARANTINED
  OUT_OF_STOCK
}

enum PsnStatus {
  DRAFT
  SUBMITTED
  AWAITING_RECEIPT
  PARTIALLY_RECEIVED
  RECEIVED
  DISCREPANCY
  CANCELLED
  // Migration 0020 — admin receiving expansion (Phase 2).
  HOLD               // Admin flagged for additional payment before release.
  REJECTED           // Admin refused the package outright. No inventory.
  RETURN_REQUESTED   // Package being shipped back unopened to vendor.
}

// Migration 0020 — lifecycle of a Hold.
enum PsnHoldStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  AUTO_RETURNED
}

enum PackagingExceptionResolution {
  PENDING
  REPACKAGE
  RETURN_TO_SENDER
  HOLD
}

// =============================================================================
// User — the authentication subject. A vendor account is an organisation; a
// User belongs to it (or is an admin with no vendor).
// =============================================================================
model User {
  id                  String      @id @default(uuid()) @db.Uuid
  email               String      @unique
  passwordHash        String      @map("password_hash")
  emailVerified       Boolean     @default(false) @map("email_verified")
  emailVerifyTokenHash String?    @map("email_verify_token_hash")
  emailVerifyExpiresAt DateTime?  @map("email_verify_expires_at")

  role                Role        @default(VENDOR)
  // null for admin users; required for VENDOR + VENDOR_SUB_USER (enforced in service)
  vendorId            String?     @map("vendor_id") @db.Uuid
  vendor              Vendor?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // MFA / TOTP
  mfaEnrolled         Boolean     @default(false) @map("mfa_enrolled")
  mfaSecretEncrypted  String?     @map("mfa_secret_encrypted")
  mfaEnrolledAt       DateTime?   @map("mfa_enrolled_at")

  // Lockout / login attempts
  failedLoginCount    Int         @default(0) @map("failed_login_count")
  lockedUntil         DateTime?   @map("locked_until")

  status              UserStatus  @default(PENDING_EMAIL_VERIFICATION)

  // Password reset
  passwordResetTokenHash String?  @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  auditEntries        AuditLogEntry[] @relation("AuditActor")

  // Personal Shopper feature back-relations.
  shopperRequestsAssigned ShopperRequest[] @relation("ShopperAssignedAdmin")
  shopperMessages         ShopperMessage[] @relation("ShopperMessageSender")
  // Migration 0023 — wire-track audit relations. Both nullable so deleting
  // the user doesn't cascade; the FK on ShopperRequest sets the column to
  // NULL on the way out.
  shopperIdVerified       ShopperRequest[] @relation("ShopperIdVerifier")
  shopperWireConfirmed    ShopperRequest[] @relation("ShopperWireConfirmer")
  // Migration 0024 — PSN chat. Vendor users + admins both sit on this
  // back-relation; the sender's role disambiguates them in the UI.
  psnMessages             PsnMessage[]     @relation("PsnMessageSender")
  // Migration 0035 — admin who flagged a StorageBox as EMPTY or REMOVED.
  // Audit trail; the FK is ON DELETE SET NULL so we don't lose box
  // history when an operator is offboarded.
  storageBoxStatusChanges StorageBox[]

  @@index([role])
  @@index([vendorId])
  @@index([status])
  @@map("users")
}

// =============================================================================
// Vendor — the organisation. Every vendor-scoped row carries vendor_id.
// =============================================================================
model Vendor {
  id            String        @id @default(uuid()) @db.Uuid
  businessName  String        @map("business_name")
  country       String        @db.Char(2) // ISO 3166-1 alpha-2

  kycStatus     KycStatus     @default(PENDING) @map("kyc_status")
  kycProviderId String?       @map("kyc_provider_id")  // e.g., Stripe Identity verification id
  kycSubmittedAt DateTime?    @map("kyc_submitted_at")
  kycApprovedAt DateTime?     @map("kyc_approved_at")
  kycRejectedAt DateTime?     @map("kyc_rejected_at")
  kycRejectionReason String?  @map("kyc_rejection_reason")
  /// Admin user id that approved / rejected / asked for resubmission. Null until any decision is made.
  kycDecidedBy  String?       @map("kyc_decided_by") @db.Uuid

  /// Public social presence — used by admin KYC reviewers to confirm the
  /// vendor is a real business. All optional; lowercased + trimmed in the
  /// service; format-checked at the DB level (see migration 0008).
  instagramHandle String? @map("instagram_handle")
  tiktokHandle    String? @map("tiktok_handle")
  xHandle         String? @map("x_handle")
  websiteUrl      String? @map("website_url")
  /// Set when an admin marks the social profile as reviewed. Cleared
  /// automatically when any handle changes — re-verification required.
  socialVerifiedAt DateTime? @map("social_verified_at")
  socialVerifiedBy String?   @map("social_verified_by") @db.Uuid

  agreementAcceptedAt   DateTime? @map("agreement_accepted_at")
  agreementVersion      String?   @map("agreement_version")

  // ---------------------------------------------------------------------------
  // KYC v2 — structured fields collected by the multi-step /verification wizard.
  // Every column is optional so legacy vendors and partial wizard progress are
  // both valid. See migration 0030 for column definitions and the rationale on
  // why we don't have a separate kyc_submissions table (single submission per
  // vendor, idempotent re-edit until reviewer approves).
  // ---------------------------------------------------------------------------

  // Section 1 — Business information
  businessType                KycBusinessType? @map("business_type")
  businessTypeOther           String?          @map("business_type_other")
  businessRegistrationNumber  String?          @map("business_registration_number")
  /// ISO 3166-1 alpha-2 country of incorporation. Distinct from `country`
  /// (the operating-region field) — a vendor may be incorporated in the UK
  /// but ship from a US warehouse.
  businessRegistrationCountry String?          @map("business_registration_country") @db.Char(2)
  businessIndustry            KycIndustry?     @map("business_industry")
  businessIndustryOther       String?          @map("business_industry_other")

  // Section 2 — Primary contact information
  contactFullName     String? @map("contact_full_name")
  contactPosition     String? @map("contact_position")
  contactPhone        String? @map("contact_phone")
  contactAddressLine1 String? @map("contact_address_line1")
  contactAddressLine2 String? @map("contact_address_line2")
  /// ISO 3166-1 alpha-2 residential country of the primary contact.
  contactCountry      String? @map("contact_country") @db.Char(2)

  // Section 3 — Identity verification (structured fields only; uploads later)
  idType           KycIdType? @map("id_type")
  idNumber         String?    @map("id_number")
  idExpirationDate DateTime?  @map("id_expiration_date") @db.Date

  // Section 4 — Business verification document uploads (migration 0032).
  //
  // Public R2 object URLs for the four KYC documents the vendor uploads
  // through the wizard's "Business verification" step. Files are PUT
  // directly to R2 from the browser with a presigned URL; only the
  // resulting public URL is persisted here. Reviewers open these
  // straight from the admin vendor detail page.
  //
  // All four are nullable to match the rest of KYC v2 (legacy vendors
  // remain valid; the wizard enforces "all four required" at final
  // submit only, mirrored on the backend by submitKycV2Schema).
  idFrontUrl      String? @map("id_front_url")
  idBackUrl       String? @map("id_back_url")
  idSelfieUrl     String? @map("id_selfie_url")
  businessDocUrl  String? @map("business_doc_url")

  // Section 5 — Inventory information
  productsStoredDescription String?             @map("products_stored_description")
  monthlyInventoryVolume    KycInventoryVolume? @map("monthly_inventory_volume")
  monthlyOrderVolume        KycOrderVolume?     @map("monthly_order_volume")
  // serviceIntent dropped in migration 0031 — see note near the enum block.

  // Section 6 — Shipping & operations
  primaryShippingCountries String?  @map("primary_shipping_countries")
  requiresReturnsHandling  Boolean? @map("requires_returns_handling")
  /// Multi-select hazard tags. Allowed values are enforced by the Zod schema
  /// at the API layer (BATTERIES / LIQUIDS / FRAGILE / HAZARDOUS / NONE).
  productHazards           String[] @default([]) @map("product_hazards")

  // Sections 7 & 8 (Payment & Wallet / Compliance Signature) intentionally
  // omitted from KYC v2 Phase 1. Final-submit is now triggered by a Review
  // step that just stamps `kycSubmittedAt` and flips the vendor into the
  // PENDING/IN_PROGRESS review queue — no typed-signature is collected here.

  status        VendorStatus  @default(PENDING_KYC)

  // ---------------------------------------------------------------------------
  // Migration 0038 — storefront-integration defaults. When an order is ingested
  // from the vendor's website there is no human to pick a shipping service, so
  // the vendor configures it once here. `integrationDefaultCarrierService` is
  // either a concrete service label ("USPS Priority") or NULL, which the
  // ingestion service treats as "cheapest available". `integrationDefaultInsurance`
  // mirrors the per-order insurance toggle for the automated path.
  // ---------------------------------------------------------------------------
  integrationDefaultCarrierService String?  @map("integration_default_carrier_service")
  integrationDefaultInsurance      Boolean  @default(false) @map("integration_default_insurance")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  users         User[]
  apiKeys       VendorApiKey[]
  products      Product[]
  skus          Sku[]
  psns          Psn[]
  inventoryMovements InventoryMovement[]
  wallet        Wallet?
  ledgerEntries LedgerEntry[]
  orders        Order[]
  // Migration 0035 — physical boxes held in the warehouse for this
  // vendor; the per-box storage billing iterates these.
  storageBoxes  StorageBox[]
  // Migration 0046 — CSV bulk-import jobs the vendor kicked off from
  // the dashboard. Retained for audit / dispute review.
  orderImportJobs OrderImportJob[]

  @@index([status])
  @@index([kycStatus])
  @@map("vendors")
}

// =============================================================================
// VendorApiKey (Migration 0038) — machine credential for the storefront
// integration. A vendor's website authenticates to POST /v1/integration/orders
// with this key instead of a human session/JWT.
//
// Key format presented to the vendor ONCE at creation:
//   uer_live_<keyId>_<secret>
// We persist only:
//   keyId      — public, indexed lookup token (safe to display)
//   secretHash — SHA-256 hex of <secret>; compared in constant time at auth
// The plaintext secret is never stored, so a leaked DB row cannot be replayed.
// Revocation is a soft delete (revokedAt) to preserve the audit trail and any
// orders that reference which key created them.
// =============================================================================
model VendorApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  vendorId    String    @map("vendor_id") @db.Uuid
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Human label so the vendor can tell keys apart ("Main site", "Staging").
  name        String

  // Public lookup token (the portion before the secret). Unique across the
  // platform so auth is an O(1) indexed lookup, not a scan of every hash.
  keyId       String    @unique @map("key_id")
  // SHA-256 hex digest of the secret half of the key.
  secretHash  String    @map("secret_hash")

  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdBy   String?   @map("created_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([vendorId])
  @@map("vendor_api_keys")
}

// =============================================================================
// Session — refresh-token-anchored. Rotated on every use; reuse triggers theft
// detection (Implementation Plan §4.1).
// =============================================================================
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash  String    @map("refresh_token_hash")
  rotatedHashes     String[]  @default([]) @map("rotated_hashes")

  userAgent         String?   @map("user_agent")
  ip                String?
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")

  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// RecoveryCode — single-use MFA backup codes. Hashed at rest.
// =============================================================================
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("recovery_codes")
}

// =============================================================================
// Product — pre-created by the vendor before they ship inventory in. SKUs
// derive from products at receiving time.
// =============================================================================
model Product {
  id              String   @id @default(uuid()) @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Vendor-supplied product code, e.g., "TSH-BLK-M". Unique per vendor.
  // Used in SKU format UER-<VendorID>-<ProductCode>-<Variant>-<Sequence>.
  code            String

  name            String
  variant         String   @default("STD")
  hsCode          String?  @map("hs_code")          // Harmonized System tariff code
  countryOfOrigin String   @map("country_of_origin") @db.Char(2)
  declaredValueCents Int   @map("declared_value_cents")

  // Dimensions (inches) and weight (oz). Used for shipping rate calc + tier sizing.
  // Length/width/height are optional — vendors often determine box size at
  // pack time. Order-fees treats nulls as 0 in the envelope calc; the carrier
  // can still rate from weight alone, just less precisely.
  weightOz        Float    @map("weight_oz")
  lengthIn        Float?   @map("length_in")
  widthIn         Float?   @map("width_in")
  heightIn        Float?   @map("height_in")

  // Storage tier the vendor declares for this product. Every SKU created
  // from receiving this product inherits the tier — drives storage billing,
  // tier-sizing, and the inventory grid. Default SMALL keeps existing rows
  // working without forcing a backfill.
  storageTier     StorageTier @default(SMALL) @map("storage_tier")

  // Migration 0040 — Fulfillment v2 shipping-cost proxy. Super-admin
  // assigns this decimal value at inventory receive time; the vendor
  // never sees it. Order-time flow: sum shippingPoints across the
  // order's product lines, look up the range in the
  // shipping_point_estimate_ranges config, show that range to the
  // vendor as a non-billable estimate. NULL means "not yet
  // assigned" — Phase B blocks order submit on any line whose
  // product still has NULL. Decimal (not Float) so bucket-boundary
  // comparisons don't drift on FP rounding.
  shippingPoints  Decimal? @map("shipping_points") @db.Decimal(10, 4)

  // Migration 0022 — optional product image. URL points at our R2 bucket;
  // upload flow mirrors shopper attachments (presigned PUT). Nullable so
  // existing products keep working without backfill.
  imageUrl        String?  @map("image_url")

  status          String   @default("ACTIVE")  // ACTIVE | ARCHIVED

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  skus            Sku[]
  psnLines        PsnLine[]
  // Migration 0044 — barcodes for the scan-at-pack workflow.
  barcodes        ProductBarcode[]

  @@unique([vendorId, code])
  @@index([vendorId, status])
  @@map("products")
}

// =============================================================================
// ProductBarcode — Migration 0044.
//
// N barcodes per product (UPC, GTIN14, internal Code128, etc.). One
// barcode maps to ONE product globally; the DB unique constraint on
// `barcode` enforces that so scan-at-pack can't disambiguate. Deleting
// a product cascades its barcodes (a stale code silently pointing at
// nothing is worse than gone).
// =============================================================================
enum BarcodeSymbology {
  EAN13
  UPC_A
  CODE128
  GTIN14
  OTHER
}

model ProductBarcode {
  id         String           @id @default(uuid()) @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  barcode    String           @unique @db.VarChar(48)
  symbology  BarcodeSymbology @default(OTHER)
  /// Vendor / admin marks their canonical retail barcode as primary.
  /// At most one primary per product (partial unique index in SQL).
  isPrimary  Boolean          @default(false) @map("is_primary")

  createdBy  String?          @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([productId, isPrimary(sort: Desc), createdAt(sort: Asc)])
  @@map("product_barcodes")
}

// =============================================================================
// SKU — a trackable unit (or batch) of inventory. Generated at receiving.
// Format: UER-<VendorID short>-<ProductCode>-<Variant>-<Sequence>
// =============================================================================
model Sku {
  // Human-readable identifier serves as PK. Immutable once created.
  id                String      @id

  vendorId          String      @map("vendor_id") @db.Uuid
  vendor            Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  productId         String      @map("product_id") @db.Uuid
  product           Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  variant           String

  // Quantities in this SKU bucket. CHECK constraints enforce non-negativity.
  quantityAvailable Int         @default(0) @map("quantity_available")
  quantityReserved  Int         @default(0) @map("quantity_reserved")

  storageTier       StorageTier @default(SMALL) @map("storage_tier")
  warehouseLocation String?     @map("warehouse_location")

  // Migration 0045 — structured location assignment. The free-text
  // `warehouseLocation` column above is kept for legacy operators
  // who dropped a room label into it, but new work should read
  // `location` which points at a curated row in inventory_locations.
  locationId        String?     @map("location_id") @db.Uuid
  location          InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  status            SkuStatus   @default(ACTIVE)

  // Migration 0034 — Model B recurring storage. Set at receive time to
  // "first of next-next month" so the first cron run after intake is
  // SKIPPED (the intake fee covered that cycle). Cron bills SKUs where
  // next_billing_date <= today, then bumps it forward one month.
  nextBillingDate   DateTime    @map("next_billing_date") @db.Date

  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  movements         InventoryMovement[]
  psnLines          PsnLine[]
  orderLines        OrderLine[]

  @@index([vendorId, status])
  @@index([productId])
  @@index([locationId])
  @@map("skus")
}

// =============================================================================
// InventoryLocation — Migration 0045.
//
// Curated catalog of warehouse locations (aisle/bay/shelf/bin). SKUs
// point at these via `sku.location_id`. Warehouse UIs read the assigned
// location on pack + PSN receive so operators know where to walk.
// =============================================================================
model InventoryLocation {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32)
  label       String   @db.VarChar(80)

  aisle       String?  @db.VarChar(16)
  bay         String?  @db.VarChar(16)
  shelf       String?  @db.VarChar(16)
  bin         String?  @db.VarChar(16)

  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(100) @map("sort_order")
  notes       String?  @db.VarChar(280)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skus        Sku[]

  @@index([isActive, sortOrder, code])
  @@map("inventory_locations")
}

// =============================================================================
// PSN (Pre-Shipment Notice) — vendor's manifest declared before shipping in.
// Implementation Plan §6.2.1.
// =============================================================================
model Psn {
  id                  String     @id @default(uuid()) @db.Uuid
  vendorId            String     @map("vendor_id") @db.Uuid
  vendor              Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status              PsnStatus  @default(DRAFT)

  // Migration 0033 — explicit shipping mode. LOOSE is the historical
  // default and matches the pre-migration inferred behaviour for any
  // PSN without a PALLET-tier declaration. PALLET / ADD_TO_PALLET are
  // distinguished by this column because they can have identical
  // `declaredBoxCounts` shapes.
  shippingMode        ShippingMode @default(LOOSE) @map("shipping_mode")

  expectedArrivalDate DateTime?  @map("expected_arrival_date")
  carrier             String?
  masterTracking      String?    @map("master_tracking")

  // Declared box counts per tier. JSON of: { SMALL: 3, MEDIUM: 1, ... }
  declaredBoxCounts   Json       @default("{}") @map("declared_box_counts")

  notes               String?

  // Onboarding fee snapshot at the time of submission (cents).
  onboardingFeeCents  Int?       @map("onboarding_fee_cents")
  onboardingFeePaidAt DateTime?  @map("onboarding_fee_paid_at")

  submittedAt         DateTime?  @map("submitted_at")
  receivedAt          DateTime?  @map("received_at")

  // Migration 0020 — admin receiving expansion outcomes. Each PSN can only
  // be rejected OR return-requested OR held — never combinations — so
  // these reason columns are denormalised on the row rather than a
  // separate table. Holds get their own table because they have lifecycle
  // (PENDING_PAYMENT → PAID / CANCELLED / AUTO_RETURNED).
  rejectedReason         String?    @map("rejected_reason")
  rejectedAt             DateTime?  @map("rejected_at")
  returnRequestedReason  String?    @map("return_requested_reason")
  returnRequestedAt      DateTime?  @map("return_requested_at")
  returnShippingCents    Int?       @map("return_shipping_cents")

  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  lines               PsnLine[]
  exceptions          PackagingException[]
  holds               PsnHold[]
  // Migration 0024 — per-PSN chat thread for vendor ↔ admin coordination.
  messages            PsnMessage[]
  // Migration 0035 — physical boxes created from this PSN at receive
  // time. Each StorageBox is one billable unit; the cron iterates
  // these instead of SKUs so vendors are charged for what we actually
  // hold (boxes), not for what they logically sell (SKUs).
  storageBoxes        StorageBox[]

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("psns")
}

// Migration 0035 — lifecycle for a physical box in our warehouse.
enum StorageBoxStatus {
  ACTIVE   // billed every 30 days on `next_billing_date`
  EMPTY    // flagged by admin; excluded from billing but kept for audit
  REMOVED  // consolidated out of the warehouse entirely; permanent
}

// Migration 0035 — one row per physical box we are holding for a
// vendor. Replaces SKU-based storage billing.
//
// Sources from a PSN at receive time: for every `(tier, count)` entry
// in `declaredBoxCounts` (or `actualBoxCounts` once admin has
// inspected the shipment), we insert one StorageBox row. Each box
// runs on its own 30-day billing cycle anchored to `received_at`; the
// receiving fee paid at PSN submission covers the first 30 days.
//
// Pallets: when `tier = PALLET`, `pallet_content_tier` and
// `pallet_content_count` describe what's inside the pallet so the
// vendor / admin sees "PALLET — 8 LARGE boxes inside" rather than a
// bare "PALLET" row with no context. Null for non-pallet tiers.
model StorageBox {
  id                  String           @id @default(uuid()) @db.Uuid
  vendorId            String           @map("vendor_id") @db.Uuid
  vendor              Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  psnId               String           @map("psn_id") @db.Uuid
  psn                 Psn              @relation(fields: [psnId], references: [id], onDelete: Restrict)

  tier                StorageTier
  receivedAt          DateTime         @map("received_at")
  // Migration 0036 — null means "bundled with parent pallet, do not
  // bill independently". Used for ADD_TO_PALLET boxes; the parent
  // pallet's StorageBox row keeps billing. The cron filters NULLs.
  nextBillingDate     DateTime?        @map("next_billing_date") @db.Date

  status              StorageBoxStatus @default(ACTIVE)

  // Pallet contents — only meaningful when tier = PALLET.
  palletContentTier   StorageTier?     @map("pallet_content_tier")
  palletContentCount  Int?             @map("pallet_content_count")

  // Audit fields for consolidation actions (mark empty / remove).
  statusNote          String?          @map("status_note")
  statusChangedAt     DateTime?        @map("status_changed_at")
  statusChangedBy     String?          @map("status_changed_by") @db.Uuid
  statusChangedByUser User?            @relation(fields: [statusChangedBy], references: [id], onDelete: SetNull)

  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([vendorId, status])
  @@index([status, nextBillingDate])
  @@index([psnId])
  @@map("storage_boxes")
}

// Migration 0024 — sender of a PsnMessage.
enum PsnMessageSender {
  VENDOR
  ADMIN
}

// Migration 0024 — per-PSN chat row. Mirrors the ShopperMessage shape
// down at line 1246 so consumers (mark-read, list, post) can lift the
// same logic without bespoke per-feature differences.
model PsnMessage {
  id              String           @id @default(uuid()) @db.Uuid
  psnId           String           @map("psn_id") @db.Uuid
  psn             Psn              @relation(fields: [psnId], references: [id], onDelete: Cascade)

  sender          PsnMessageSender
  senderUserId    String?          @map("sender_user_id") @db.Uuid
  senderUser      User?            @relation("PsnMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  body            String
  attachmentUrls  String[]         @map("attachment_urls")

  readByVendorAt  DateTime?        @map("read_by_vendor_at")
  readByAdminAt   DateTime?        @map("read_by_admin_at")

  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([psnId, createdAt])
  @@map("psn_messages")
}

// Migration 0020 — PSN hold lifecycle. Each hold is one cycle of
// PENDING_PAYMENT → PAID (or CANCELLED / AUTO_RETURNED). A single PSN can
// have at most one active (PENDING_PAYMENT) hold at a time; the unique
// partial index is enforced at the service layer (Postgres lacks partial
// uniques on Prisma).
model PsnHold {
  id                String        @id @default(uuid()) @db.Uuid
  psnId             String        @map("psn_id") @db.Uuid
  psn               Psn           @relation(fields: [psnId], references: [id], onDelete: Cascade)

  extraChargeCents  Int           @map("extra_charge_cents")
  reasonCode        String        @map("reason_code")
  reasonNote        String        @map("reason_note")
  status            PsnHoldStatus @default(PENDING_PAYMENT)

  createdBy         String?       @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  paidAt            DateTime?     @map("paid_at")
  releaseAfter      DateTime      @map("release_after")
  ledgerEntryId     String?       @map("ledger_entry_id") @db.Uuid

  @@index([psnId, status])
  @@index([status, releaseAfter])
  @@map("psn_holds")
}

model PsnLine {
  id            String   @id @default(uuid()) @db.Uuid
  psnId         String   @map("psn_id") @db.Uuid
  psn           Psn      @relation(fields: [psnId], references: [id], onDelete: Cascade)

  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Once SKUs are generated at receiving, the line points to the SKU bucket.
  skuId         String?  @map("sku_id")
  sku           Sku?     @relation(fields: [skuId], references: [id], onDelete: SetNull)

  declaredQty   Int      @map("declared_qty")
  receivedQty   Int      @default(0) @map("received_qty")
  acceptedQty   Int      @default(0) @map("accepted_qty")
  damagedQty    Int      @default(0) @map("damaged_qty")
  // Migration 0024 — items declared but not in the box (lost / mispacked).
  // Distinct from damagedQty because the financial story is different.
  missingQty    Int      @default(0) @map("missing_quantity")

  notes         String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([psnId])
  @@map("psn_lines")
}

model PackagingException {
  id          String                       @id @default(uuid()) @db.Uuid
  psnId       String                       @map("psn_id") @db.Uuid
  psn         Psn                          @relation(fields: [psnId], references: [id], onDelete: Cascade)

  resolution  PackagingExceptionResolution @default(PENDING)
  feeCents    Int                          @default(0) @map("fee_cents")
  notes       String?

  createdAt   DateTime                     @default(now()) @map("created_at")
  resolvedAt  DateTime?                    @map("resolved_at")

  @@index([psnId])
  @@map("packaging_exceptions")
}

// =============================================================================
// InventoryMovement — append-only log of every quantity change. Forms the
// audit trail for stock counts and feeds reconciliation.
// =============================================================================
model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  skuId       String   @map("sku_id")
  sku         Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  // RECEIVE | RESERVE | RELEASE | SHIP | RETURN | ADJUST | DAMAGE | TRANSFER
  type        String

  // Signed delta (positive = in, negative = out). Multiple deltas may accompany
  // a single event (e.g., ship: -1 from available + -1 from reserved). Each is
  // its own row.
  deltaAvailable Int   @default(0) @map("delta_available")
  deltaReserved  Int   @default(0) @map("delta_reserved")

  // Free-text note, e.g., "Cycle count correction", "Damage: water damage".
  reason      String?

  // Reference to the originating event (PSN id, order id, return id, etc.).
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  actorId     String?  @map("actor_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@index([skuId, createdAt])
  @@map("inventory_movements")
}

// =============================================================================
// IdempotencyKey — guards every state-changing endpoint. Same key + same body
// returns the original response. Implementation Plan §11.1.
// =============================================================================
model IdempotencyKey {
  key             String   @id
  endpoint        String
  requestHash     String   @map("request_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  // Optional vendor scope so the same key collisionable across vendors is fine.
  vendorId        String?  @map("vendor_id") @db.Uuid

  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  @@index([expiresAt])
  @@index([vendorId, endpoint])
  @@map("idempotency_keys")
}

// =============================================================================
// AuditLogEntry — append-only at DB privilege level (migration 0002).
// =============================================================================
model AuditLogEntry {
  id            String   @id @default(uuid()) @db.Uuid

  actorId       String?  @map("actor_id") @db.Uuid
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole     Role?    @map("actor_role")
  onBehalfOfVendorId String? @map("on_behalf_of_vendor_id") @db.Uuid

  sourceIp      String?  @map("source_ip")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")

  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")

  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_log_entries")
}

// =============================================================================
// Wallet — one per vendor. Materialized view of the ledger; reconciled
// nightly. Implementation Plan §6.4.
// =============================================================================
enum WalletStatus {
  ACTIVE
  STORAGE_OVERDUE
  SUSPENDED
  CLOSED
}

model Wallet {
  id                       String       @id @default(uuid()) @db.Uuid
  vendorId                 String       @unique @map("vendor_id") @db.Uuid
  vendor                   Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Materialized balance. Reconciled by daily job; always equals the sum of
  // ledger_entries.amount_cents for this vendor. CHECK enforces non-negative.
  balanceCents             Int          @default(0) @map("balance_cents")
  // Configurable per vendor; default $50.00 (5000 cents).
  lowBalanceThresholdCents Int          @default(5000) @map("low_balance_threshold_cents")

  status                   WalletStatus @default(ACTIVE)

  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  @@map("wallets")
}

// =============================================================================
// LedgerEntry — append-only at the DB privilege level. Implementation Plan §6.4.2.
// One row per money event; balance_after_cents is captured per row so the
// historical balance trail never needs reconstruction.
// =============================================================================
enum LedgerEntryType {
  DEPOSIT
  ONBOARDING
  STORAGE
  FULFILLMENT
  SHIPPING
  RETURN
  MANUAL_CREDIT
  MANUAL_DEBIT
  REVERSAL
  // Migration 0019 — Phase 2 (receiving holds) + Shopper request
  // transactions unified into the same ledger.
  RECEIVING_HOLD_FEE
  PARTNERSHIP_ITEM_COST
  PURCHASE_FEE
  REFUND
}

model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  // Vendor wallet entries: vendorId is set, balanceAfterCents is set.
  // Shopper-request entries (migration 0019): vendorId is NULL,
  // shopperRequestId is set, balanceAfterCents is NULL. A DB CHECK
  // enforces exactly-one-subject per row.
  vendorId          String?         @map("vendor_id") @db.Uuid
  vendor            Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Migration 0019 — shopper-side ledger entries reference a shopper_request
  // instead of a vendor. ON DELETE RESTRICT keeps the audit trail intact.
  shopperRequestId  String?         @map("shopper_request_id") @db.Uuid
  shopperRequest    ShopperRequest? @relation("ShopperRequestLedger", fields: [shopperRequestId], references: [id], onDelete: Restrict)

  type              LedgerEntryType
  // Signed cents: positive for deposits/credits, negative for charges/debits.
  amountCents       Int             @map("amount_cents")
  // Materialized balance immediately AFTER this entry was applied.
  // NULL for shopper rows (no wallet, no running balance).
  balanceAfterCents Int?            @map("balance_after_cents")

  description       String

  // Origin: "psn", "stripe", "order", "return", "shopper_request", etc.
  referenceType     String?         @map("reference_type")
  referenceId       String?         @map("reference_id")

  // Idempotency key used for the originating request, if any.
  idempotencyKey    String?         @map("idempotency_key")

  // Who initiated. Null for system events (cron-driven storage fees).
  createdBy         String?         @map("created_by") @db.Uuid

  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([shopperRequestId, createdAt])
  @@map("ledger_entries")
}

// =============================================================================
// Notification — in-app messages. Email parity is delegated to the email queue
// when notifications are emitted (P2.12).
// =============================================================================
enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id          String                @id @default(uuid()) @db.Uuid
  // Recipient. For vendor notifications, vendor_id is set; for admin-targeted
  // notifications a user_id may be set instead. Exactly one of the two.
  vendorId    String?               @map("vendor_id") @db.Uuid
  userId      String?               @map("user_id") @db.Uuid

  // Stable type code so the UI can route + group: e.g., "wallet.low_balance".
  type        String
  severity    NotificationSeverity  @default(INFO)
  title       String
  body        String
  // Optional deep link, e.g., "/wallet/fund".
  href        String?

  readAt      DateTime?             @map("read_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([vendorId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

// =============================================================================
// WebhookEvent — idempotent inbound webhook log. Replay-safe by event id.
// =============================================================================
model WebhookEvent {
  id           String   @id @default(uuid()) @db.Uuid
  // Provider name: "stripe", "easypost", "kyc"
  provider     String
  // Provider-issued unique event identifier (e.g., Stripe evt_xxx). Unique scoped to provider.
  eventId      String   @map("event_id")
  // Raw normalized payload, retained for support / debugging.
  payload      Json
  processedAt  DateTime? @map("processed_at")
  error        String?

  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, processedAt])
  @@map("webhook_events")
}

// =============================================================================
// Order — fulfillment workflow. Implementation Plan §6.6.
// Created from a quote; transitions through a strict state machine. Money is
// debited from the wallet at submit time and (a) refunded on cancel-before-pick,
// (b) reassessed (delta debited or refunded) after the box is actually weighed,
// (c) refunded on RETURNED → RESTOCKED.
// =============================================================================
enum OrderStatus {
  DRAFT
  SUBMITTED
  // Migration 0038 — storefront-integration hold. An order ingested from
  // a vendor's website that could NOT be allocated immediately: either the
  // wallet can't cover the fee (INSUFFICIENT_FUNDS) or a line's SKU didn't
  // match a product code (UNMAPPED_SKU). The reason is on orders.hold_reason.
  // INSUFFICIENT_FUNDS holds DO reserve stock (the customer already paid the
  // vendor, so we protect the units); UNMAPPED_SKU holds do not, since we
  // don't yet know which SKU to reserve. Released to ALLOCATED once resolved.
  ON_HOLD
  ALLOCATED          // stock reserved, label not yet generated
  LABEL_PURCHASED    // shipping label bought from carrier
  PICKING
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  EXCEPTION          // carrier exception (lost, damaged, refused)
  CANCELLED
  RETURNED
  // Migration 0037 — terminal status for orders shipped on the vendor's
  // own carrier account. The package has left the warehouse but the
  // carrier was the vendor's, so we never bought a Shippo label. No
  // automatic tracking webhook fires after this point — the vendor or
  // their recipient tracks via the vendor's carrier portal.
  HANDED_OFF

  // -------------------------------------------------------------------------
  // Migration 0041 — Fulfillment v2 status flow.
  //
  // Orders created under workflowVersion=2 (feature-flag gated by
  // fulfillment_v2_enabled) live in this side of the state machine:
  //
  //   PENDING_PACKING              →  order accepted, fulfillment fee
  //                                   debited. Waiting for warehouse to
  //                                   start packing.
  //   PACKING_COMPLETED            →  warehouse finished packing; entered
  //                                   actual weight + dimensions.
  //   AWAITING_SHIPPING_SELECTION  →  live Shippo rates ready; admin
  //                                   picks any option.
  //   AWAITING_WALLET_FUNDING      →  rate picked but wallet couldn't
  //                                   cover actual shipping cost. Order
  //                                   is packed and sitting on the dock
  //                                   until the vendor funds the wallet.
  //   SHIPPING_PAID                →  wallet debited for actual shipping,
  //                                   label buy is the next step.
  //
  // From SHIPPING_PAID → LABEL_PURCHASED (existing enum) → SHIPPED →
  // DELIVERED. The tail statuses are shared with the legacy flow so
  // downstream code (returns, tracking webhook, reassessment cron)
  // doesn't need a second dispatch.
  // -------------------------------------------------------------------------
  PENDING_PACKING
  PACKING_COMPLETED
  AWAITING_SHIPPING_SELECTION
  AWAITING_WALLET_FUNDING
  SHIPPING_PAID
}

// Migration 0037 — fulfillment branch chosen by the vendor at order
// creation. PLATFORM_SHIP keeps the existing Shippo-driven flow;
// VENDOR_CARRIER skips Shippo entirely and we do pick + pack + hand-off
// against a label the vendor supplies (uploaded file or carrier +
// tracking they typed in). New orders default to PLATFORM_SHIP so
// historical rows retain their existing semantics without backfill.
enum FulfillmentMode {
  PLATFORM_SHIP
  VENDOR_CARRIER
}

enum OrderCancelReason {
  VENDOR_REQUEST
  OUT_OF_STOCK
  ADDRESS_INVALID
  CARRIER_REFUSED
  FRAUD_HOLD
  OTHER
}

model Order {
  id                       String          @id @default(uuid()) @db.Uuid
  vendorId                 String          @map("vendor_id") @db.Uuid
  vendor                   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Human-friendly, monotonic order number — rendered as "#1625" in the
  // portal, emails, and labels. Globally unique across the platform, backed
  // by Postgres sequence `orders_order_number_seq` (migration 0029). The
  // application omits this field on create so the DB default populates it
  // atomically; we never compute it in app code to avoid races.
  orderNumber              Int             @unique @default(dbgenerated("nextval('orders_order_number_seq'::regclass)")) @map("order_number")

  // Migration 0040 — Fulfillment workflow discriminator.
  //   1 = legacy flow (vendor picks carrier at submit, wallet debited
  //       for everything, admin buys label)
  //   2 = v2 flow (fulfillment fee only at submit, warehouse packs
  //       first, live Shippo rates at pack time, wallet debited for
  //       actual shipping, then label bought)
  // Existing rows backfill to 1 so nothing in flight changes
  // behaviour. Set at create time; never mutated. Every transition
  // service reads this and dispatches to the correct handler so the
  // two flows can coexist while old orders finish under old rules.
  workflowVersion          Int             @default(1) @map("workflow_version")

  // Vendor's external order id (their Shopify/WooCommerce/etc. number). Indexed
  // for lookup; uniqueness scoped to vendor so two vendors can share an id.
  // Optional informational field — the PRIMARY identifier shown to vendors is
  // `orderNumber` above. external_reference exists for vendors who want to
  // cross-reference back to their own store / OMS.
  externalReference        String?         @map("external_reference")

  // Migration 0038 — where this order came from. MANUAL = entered by a human
  // in the portal (the historical default, so every existing row is MANUAL).
  // API = ingested from the vendor's storefront via the integration endpoint.
  // Drives the admin "source" column/filter and the storefront status lookup.
  source                   String          @default("MANUAL")
  // Set only while status = ON_HOLD. One of INSUFFICIENT_FUNDS | UNMAPPED_SKU
  // | ADDRESS_INVALID. Cleared when the order is released to ALLOCATED.
  holdReason               String?         @map("hold_reason")
  // Normalized inbound payload retained on held orders so an admin can resolve
  // the hold (remap a SKU, see the recipient/lines) without the storefront
  // re-sending. Null on normally-allocated orders.
  sourcePayload            Json?           @map("source_payload")

  status                   OrderStatus     @default(DRAFT)

  // ---- Recipient (PII). v1 stored plain; lives behind tenant scoping + audit.
  // Future: encrypt name/phone/email at rest via CryptoService field encryption.
  recipientName            String          @map("recipient_name")
  recipientPhone           String?         @map("recipient_phone")
  recipientEmail           String?         @map("recipient_email")
  shipAddressLine1         String          @map("ship_address_line1")
  shipAddressLine2         String?         @map("ship_address_line2")
  shipCity                 String          @map("ship_city")
  shipState                String          @map("ship_state")           // 2-letter US state, validated app-side
  shipPostalCode           String          @map("ship_postal_code")
  shipCountry              String          @default("US") @map("ship_country") @db.Char(2)

  // Smarty validation cache. ACCEPTED | NEEDS_VERIFICATION | REJECTED.
  addressValidationStatus  String          @default("PENDING") @map("address_validation_status")
  addressValidationDetail  Json?           @map("address_validation_detail")

  // ---- Carrier / label
  carrier                  String?         // "usps", "ups", "fedex"
  carrierService           String?         @map("carrier_service")     // "USPS Priority", "UPS Ground", etc.
  trackingNumber           String?         @map("tracking_number")
  labelUrl                 String?         @map("label_url")            // signed URL to PDF
  rateProviderRef          String?         @map("rate_provider_ref")    // EasyPost shipment id
  ratePurchasedRef         String?         @map("rate_purchased_ref")   // EasyPost rate id

  // ---- Migration 0037 — vendor-carrier fulfillment-only branch.
  //
  // When `fulfillment_mode = VENDOR_CARRIER` we skip Shippo entirely
  // and use whichever of these three fields the vendor populated at
  // intake:
  //   vendorCarrierName     — free-text carrier label ("UPS", "DHL")
  //   vendorTrackingNumber  — carrier-issued tracking number
  //   vendorLabelUrl        — R2 URL to the pre-paid label PDF/image
  // Service-layer validation enforces "at least one of (label URL) OR
  // (carrier + tracking) must be present" — never both columns blank.
  //
  // For PLATFORM_SHIP rows all three stay NULL and the existing
  // carrier / trackingNumber / labelUrl columns above carry the
  // Shippo-purchased equivalents instead.
  fulfillmentMode          FulfillmentMode @default(PLATFORM_SHIP) @map("fulfillment_mode")
  vendorCarrierName        String?         @map("vendor_carrier_name")
  vendorTrackingNumber     String?         @map("vendor_tracking_number")
  vendorLabelUrl           String?         @map("vendor_label_url")
  handedOffAt              DateTime?       @map("handed_off_at")

  // ---- Money (cents). Captured at submit time so future fee schedule changes
  // do not retro-apply. Reassessment writes a separate ledger entry.
  itemsDeclaredValueCents  Int             @default(0) @map("items_declared_value_cents")
  shippingCostCents        Int             @default(0) @map("shipping_cost_cents")     // what carrier charged us
  shippingFeeCents         Int             @default(0) @map("shipping_fee_cents")      // what we charge vendor (cost + markup)
  fulfillmentFeeCents      Int             @default(0) @map("fulfillment_fee_cents")   // pick/pack
  insuranceFeeCents        Int             @default(0) @map("insurance_fee_cents")
  totalChargedCents        Int             @default(0) @map("total_charged_cents")     // sum debited from wallet

  // Reassessment delta (positive = vendor charged more after weigh; negative = refund).
  reassessmentDeltaCents   Int             @default(0) @map("reassessment_delta_cents")
  reassessedAt             DateTime?       @map("reassessed_at")

  // Migration 0041 — Fulfillment v2 estimated shipping range.
  //
  // Set only when the order is created under workflowVersion=2 (feature-flag
  // gated by fulfillment_v2_enabled). Populated from
  // ShippingPointService.resolveRange(sum-of-product-points) at submit time
  // and shown to the vendor as a non-billable estimate. `Max` is ALSO used
  // by wallet-cover validation: the vendor must have wallet balance >=
  // fulfillmentFeeCents + estimatedShippingMaxCents to submit.
  //
  // Both NULL for legacy (workflowVersion=1) orders — those already have a
  // Shippo-quoted shippingCostCents at submit.
  estimatedShippingMinCents Int?           @map("estimated_shipping_min_cents")
  estimatedShippingMaxCents Int?           @map("estimated_shipping_max_cents")

  // Migration 0042 — Fulfillment v2 pack-step columns.
  //
  // Populated by the warehouse when they physically pack the order and
  // record real box dimensions + weight. All four are null until then.
  // Enforced ALL-OR-NONE by a DB check constraint so a partial write
  // can't leave the row half-populated. Units:
  //   * length/width/height in INCHES (decimal, 1 fractional digit)
  //   * weight              in OUNCES (integer)
  //
  // Values feed the live Shippo rate fetch that follows the pack step.
  packedLengthIn           Decimal?        @db.Decimal(6, 1) @map("packed_length_in")
  packedWidthIn            Decimal?        @db.Decimal(6, 1) @map("packed_width_in")
  packedHeightIn           Decimal?        @db.Decimal(6, 1) @map("packed_height_in")
  packedWeightOz           Int?            @map("packed_weight_oz")
  packedByUserId           String?         @map("packed_by_user_id") @db.Uuid
  packingNotes             String?         @map("packing_notes")

  // Migration 0043 — optional link to the packaging preset selected
  // by the operator at pack time. NULL when dims were typed ad-hoc.
  // ON DELETE SET NULL so retiring a preset never nulls historical
  // pack rows (the concrete dims stay on packed_*_in columns).
  packagingOptionId        String?         @map("packaging_option_id") @db.Uuid
  packagingOption          PackagingOption? @relation(fields: [packagingOptionId], references: [id], onDelete: SetNull)

  // Migration 0049 — Shippo parcel-template id captured at pack time.
  // Set when the operator picked a carrier packaging template (Option A
  // in the spec) OR a library preset whose shippo_template was non-null.
  // fetchRates passes this to shippo.getRates({ parcel.template }) so
  // flat-rate / one-rate / simple-rate pricing lands in the returned
  // rate list. NULL for custom / ad-hoc packaging — weight-based rates.
  parcelTemplate           String?         @map("parcel_template") @db.VarChar(60)

  // ---- Cancellation
  cancelReason             OrderCancelReason? @map("cancel_reason")
  cancelNote               String?         @map("cancel_note")

  // ---- Timeline timestamps
  submittedAt              DateTime?       @map("submitted_at")
  allocatedAt              DateTime?       @map("allocated_at")
  labelPurchasedAt         DateTime?       @map("label_purchased_at")
  pickingStartedAt         DateTime?       @map("picking_started_at")
  packedAt                 DateTime?       @map("packed_at")
  shippedAt                DateTime?       @map("shipped_at")
  deliveredAt              DateTime?       @map("delivered_at")
  cancelledAt              DateTime?       @map("cancelled_at")

  createdBy                String?         @map("created_by") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  lines                    OrderLine[]
  events                   OrderEvent[]
  returns                  Return[]
  // Migration 0042 — cached Shippo rate options fetched at pack time.
  rateOptions              OrderShippingRateOption[]

  @@unique([vendorId, externalReference], name: "vendor_external_ref_unique")
  @@index([vendorId, status, createdAt])
  @@index([status, createdAt])
  @@index([trackingNumber])
  @@index([carrier, status])
  @@index([fulfillmentMode, status])
  // Migration 0038 — admin "storefront orders" + held-orders queues filter on
  // these, e.g. WHERE source = 'API' AND status = 'ON_HOLD'.
  @@index([source, status, createdAt])
  @@map("orders")
}

// =============================================================================
// OrderLine — line item snapshot. SKU + qty + price captured at submit so the
// historical record is immutable even if pricing changes later.
// =============================================================================
model OrderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Vendor scope echoed for tenant-guard cross-checks at the row level.
  vendorId            String   @map("vendor_id") @db.Uuid

  productId           String   @map("product_id") @db.Uuid
  skuId               String   @map("sku_id")
  sku                 Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  // Snapshot of product info at order time.
  productCode         String   @map("product_code")
  productName         String   @map("product_name")
  variant             String

  quantity            Int
  declaredValueCents  Int      @map("declared_value_cents")  // unit declared value × qty

  // Allocation status: PENDING | RESERVED | PICKED | SHIPPED | RETURNED | CANCELLED.
  allocationStatus    String   @default("PENDING") @map("allocation_status")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([skuId])
  @@index([vendorId])
  @@map("order_lines")
}

// =============================================================================
// OrderEvent — append-only timeline (carrier tracking events + internal
// transitions). Powers the order detail timeline and the audit trail.
// =============================================================================
model OrderEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Stable code: "order.submitted", "order.allocated", "carrier.in_transit",
  // "carrier.delivered", "carrier.exception", "order.cancelled", etc.
  type        String
  description String

  // Optional carrier-supplied metadata (location, status code, signed-by).
  metadata    Json?

  // Origin of the event: SYSTEM | VENDOR | ADMIN | CARRIER | CRON
  source      String   @default("SYSTEM")
  actorId     String?  @map("actor_id") @db.Uuid

  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId, occurredAt])
  @@index([type, occurredAt])
  @@map("order_events")
}

// =============================================================================
// Return — RMA-style return. One return spans 1..N order lines.
// Implementation Plan §6.7.
// =============================================================================
enum ReturnStatus {
  REQUESTED
  AUTHORIZED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  INSTRUCTED
  RESTOCKED
  DISPOSED
  DONATED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  NOT_AS_DESCRIBED
  DEFECTIVE
  WRONG_ITEM
  CHANGED_MIND
  ARRIVED_DAMAGED
  NEVER_DELIVERED
  OTHER
}

// =============================================================================
// PackagingOption — Migration 0043.
//
// Shared, admin-maintained catalog of shippable box / mailer presets.
// The warehouse pack step reads from this table so an operator can
// pick "Medium Flat Rate Box" instead of typing 11 × 8.5 × 5.5. When a
// preset is selected, its dims populate the pack-time dimensions and
// its tare weight is added to the operator-entered goods weight.
// =============================================================================
/// Migration 0049 — poly mailers vs boxes. Poly mailers use L+W only
/// on the operator form (height is a floor for Shippo); boxes use L+W+H.
enum PackagingType {
  POLY_MAILER
  BOX
}

model PackagingOption {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique @db.VarChar(32)
  label          String        @db.VarChar(80)

  packagingType  PackagingType @default(BOX) @map("packaging_type")

  lengthIn       Decimal       @db.Decimal(6, 1) @map("length_in")
  widthIn        Decimal       @db.Decimal(6, 1) @map("width_in")
  heightIn       Decimal       @db.Decimal(6, 1) @map("height_in")

  /// Empty-box weight added to the operator-entered goods weight before
  /// the parcel is priced. Ounces.
  tareWeightOz   Int           @default(0) @map("tare_weight_oz")

  /// Migration 0049 — Shippo carrier template id (e.g. USPS_MediumFlatRateBox1).
  /// When set, OrderPackService.fetchRates passes this as `parcel.template`
  /// so Shippo returns flat-rate / one-rate / simple-rate pricing. NULL for
  /// custom presets — those get plain weight-based rates.
  shippoTemplate String?       @db.VarChar(60) @map("shippo_template")

  isActive       Boolean       @default(true) @map("is_active")
  sortOrder      Int           @default(100) @map("sort_order")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  orders         Order[]

  @@index([isActive, sortOrder, label])
  @@map("packaging_options")
}

// =============================================================================
// OrderImportJob — Migration 0046.
//
// Bulk CSV import from the vendor dashboard. One row per uploaded
// file; per-row failures are captured in `errors` (JSONB array of
// `{ row: number, message: string }`). Retained indefinitely for
// dispute review — finance may need to correlate a mis-charged
// order against the row that produced it.
// =============================================================================
enum ImportJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model OrderImportJob {
  id              String          @id @default(uuid()) @db.Uuid
  vendorId        String          @map("vendor_id") @db.Uuid
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status          ImportJobStatus @default(PROCESSING)
  sourceFilename  String          @map("source_filename") @db.VarChar(200)

  rowCount        Int             @default(0) @map("row_count")
  successCount    Int             @default(0) @map("success_count")
  errorCount      Int             @default(0) @map("error_count")
  /// Bounded at write time (service caps to 100 entries) — a fully
  /// failed 400-row file still serialises cleanly.
  errors          Json            @default("[]")

  createdBy       String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  @@index([vendorId, createdAt(sort: Desc)])
  @@index([status])
  @@map("order_import_jobs")
}

// =============================================================================
// OrderShippingRateOption — Migration 0042.
//
// Cached Shippo rate options fetched at pack-completion time. The admin
// picker reads these instead of re-hitting the carrier API. The chosen
// row's rate_provider_ref is passed straight through to Shippo when the
// label is bought. Rows are CASCADE-deleted with the order.
// =============================================================================
model OrderShippingRateOption {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Provider-supplied rate id — the token Shippo uses to purchase a label.
  rateProviderRef        String   @map("rate_provider_ref")
  /// Provider-supplied shipment id this rate belongs to.
  shipmentProviderRef    String   @map("shipment_provider_ref")

  carrier                String
  service                String
  costCents              Int      @map("cost_cents")
  estimatedDeliveryDays  Int      @map("estimated_delivery_days")

  fetchedAt              DateTime @default(now()) @map("fetched_at")

  @@unique([orderId, rateProviderRef], name: "order_rate_provider_ref_unique")
  @@index([orderId])
  @@index([fetchedAt])
  @@map("order_shipping_rate_options")
}

model Return {
  id                String        @id @default(uuid()) @db.Uuid
  vendorId          String        @map("vendor_id") @db.Uuid

  orderId           String        @map("order_id") @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  rmaCode           String        @unique @map("rma_code")  // "RMA-<short>", customer-facing
  status            ReturnStatus  @default(REQUESTED)
  reason            ReturnReason

  // Inbound tracking back to warehouse. Vendor-supplied at creation
  // (Returns v2 / migration 0052) — the customer pays return shipping,
  // so USA Errands no longer buys an inbound label. inboundLabelUrl is
  // retained for historical rows but no longer written.
  inboundTracking   String?       @map("inbound_tracking")
  inboundCarrier    String?       @map("inbound_carrier")
  inboundLabelUrl   String?       @map("inbound_label_url")

  // Migration 0052 — vendor's expected inbound delivery date.
  expectedDeliveryDate DateTime?  @map("expected_delivery_date") @db.Date

  // Returns v2 money (migration 0052): USA Errands CHARGES the vendor a
  // flat processing fee per return (the work of receiving + checking),
  // plus any handling/shipping cost. There is NO product refund.
  processingFeeCents Int          @default(0) @map("processing_fee_cents")
  handlingCostCents  Int          @default(0) @map("handling_cost_cents")

  // Legacy refund columns (pre-v2). No longer written; kept for the
  // audit history of returns resolved under the old refund model.
  refundAmountCents Int           @default(0) @map("refund_amount_cents")
  restockFeeCents   Int           @default(0) @map("restock_fee_cents")

  // Condition summary shared with the vendor at inspection.
  inspectorNotes    String?       @map("inspector_notes")

  // Migration 0052 — photos USA Errands takes of the received items and
  // shares with the vendor before asking for handling instructions.
  receivedPhotoUrls String[]      @default([]) @map("received_photo_urls")

  // Migration 0018 — vendor-supplied evidence at RMA creation. Photos
  // of damage, screenshots of customer messages, etc. Stored as R2
  // public URLs (uploaded via the same presigned-PUT flow as the
  // shopper attachments). Inspector reviews these on the admin detail
  // page so "defective / arrived damaged" claims have proof attached.
  attachmentUrls    String[]      @default([]) @map("attachment_urls")

  requestedAt       DateTime      @default(now()) @map("requested_at")
  authorizedAt      DateTime?     @map("authorized_at")
  receivedAt        DateTime?     @map("received_at")
  inspectedAt       DateTime?     @map("inspected_at")
  resolvedAt        DateTime?     @map("resolved_at")

  createdBy         String?       @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  lines             ReturnLine[]

  @@index([vendorId, status, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("returns")
}

model ReturnLine {
  id                  String   @id @default(uuid()) @db.Uuid
  returnId            String   @map("return_id") @db.Uuid
  return              Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  // Mirror to the originating OrderLine.
  orderLineId         String   @map("order_line_id") @db.Uuid
  skuId               String   @map("sku_id")

  requestedQty        Int      @map("requested_qty")
  receivedQty         Int      @default(0) @map("received_qty")
  // Disposition split — set by the VENDOR's instructions (Returns v2)
  // and applied by the admin at finalize. restocked returns to
  // inventory; disposed/donated do not. damagedQty is retained from the
  // pre-v2 model (no longer written; condition is captured in photos +
  // inspector notes).
  restockedQty        Int      @default(0) @map("restocked_qty")
  damagedQty          Int      @default(0) @map("damaged_qty")
  disposedQty         Int      @default(0) @map("disposed_qty")
  donatedQty          Int      @default(0) @map("donated_qty")

  notes               String?

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([returnId])
  @@index([orderLineId])
  @@map("return_lines")
}

// =============================================================================
// VendorInvitation — sub-user invite. Implementation Plan §6.12.
//
// Flow:
//   1. Vendor admin invites an email at role VENDOR_SUB_USER.
//   2. We email a single-use, hashed-at-rest token (24h TTL).
//   3. The recipient hits the public accept-invite endpoint with the token,
//      sets a password, and is redirected to MFA enrolment.
//   4. The User row is created and joined to the vendor.
// =============================================================================
enum VendorInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model VendorInvitation {
  id            String                 @id @default(uuid()) @db.Uuid
  vendorId      String                 @map("vendor_id") @db.Uuid

  email         String                 // case-insensitive comparison enforced in service
  // Single-use token stored as sha256 hash. Plaintext is emailed once.
  tokenHash     String                 @map("token_hash")
  // Role granted on accept. Currently always VENDOR_SUB_USER; modelled for
  // future expansion (e.g., VENDOR_FINANCE_ADMIN).
  roleAtAccept  Role                   @default(VENDOR_SUB_USER) @map("role_at_accept")

  status        VendorInvitationStatus @default(PENDING)
  invitedBy     String                 @map("invited_by") @db.Uuid

  expiresAt     DateTime               @map("expires_at")
  acceptedAt    DateTime?              @map("accepted_at")
  revokedAt     DateTime?              @map("revoked_at")

  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  // Two open invitations to the same email on the same vendor are prevented
  // at the service layer; the unique below covers active accepted rows so an
  // accepted invite is never reused.
  @@unique([tokenHash])
  @@index([vendorId, status, createdAt])
  @@index([email])
  @@map("vendor_invitations")
}

// =============================================================================
// Configuration — fee schedule, tier dimensions, thresholds. All updates audited.
// =============================================================================
model Configuration {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("configuration")
}

// =============================================================================
// Personal Shopper — public-facing service. A buyer pastes product links,
// pays upfront for items + commission, and the platform procures + ships.
// No vendor in the loop; the platform is the merchant of record for the
// service. Buyers are tied to email + magic-link tokens; no User row.
// Implementation Plan §6.10 (added in migration 0011).
// =============================================================================

enum ShopperRequestStatus {
  AWAITING_INTAKE_PAYMENT
  PAID
  PROCURING
  // Migration 0021 — admin marked all lines as PURCHASED / UNAVAILABLE.
  // Items are bought, waiting for them to arrive at the warehouse before
  // they can ship onward. Replaces the AWAITING_RECONCILIATION + followup-
  // payment flow which has been retired (estimates are now the price; if
  // actuals differ, admin cancels and asks buyer to rebook).
  AWAITING_DELIVERY
  AWAITING_RECONCILIATION
  READY_TO_SHIP
  // Migration 0025a — PICKUP-method readiness state. PLATFORM_FREIGHT /
  // BUYER_FORWARDER / BUYER_FREIGHT all share READY_TO_SHIP since they
  // transition to SHIPPED next. PICKUP transitions from READY_FOR_PICKUP
  // to DELIVERED when the admin records the in-person handoff.
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  // Migration 0023a — wire-transfer + ID-verification track for buyers
  // whose items subtotal crosses the configured threshold (default
  // $1,000). The buyer never sees Stripe; they verify ID, get a quote
  // with bank details, wire the money, and we confirm before procuring.
  AWAITING_ID_VERIFICATION
  ID_UNDER_REVIEW
  QUOTE_SENT
  AWAITING_WIRE_PAYMENT
  WIRE_PROOF_UPLOADED
  WIRE_UNDER_REVIEW
  WIRE_CONFIRMED
  PURCHASE_APPROVED
}

// Migration 0023 — which payment rail this request is on. Server-derived
// at intake from items_subtotal vs `shopper_wire_threshold_cents`.
enum ShopperPaymentMethod {
  STRIPE
  WIRE
}

// Migration 0023 — lifecycle of the buyer's gov-ID upload. Manual review
// by admin is the only approver in v1; Stripe Identity is a possible v2.
enum ShopperIdVerificationStatus {
  NONE
  PENDING_UPLOAD
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ShopperMessageSender {
  BUYER
  ADMIN
}

enum ShopperShippingMethod {
  PLATFORM_FREIGHT
  // Migration 0025a — buyer supplies their own carrier label (we apply
  // it and hand the package off without quoting freight). Distinct from
  // BUYER_FORWARDER, where the buyer routes through a US freight
  // forwarder and we still ship + price the freight to that address.
  BUYER_FREIGHT
  BUYER_FORWARDER
  PICKUP
}

model ShopperRequest {
  id                          String                 @id @default(uuid()) @db.Uuid

  // Migration 0015 — short, human-readable reference (SHP-000042). UNIQUE,
  // generated from a Postgres sequence in application code at create time.
  reference                   String                 @unique

  // Migration 0015 — optional FK to the previous request the buyer is
  // adding to. Self-relation; SET NULL on parent delete so an orphaned
  // child stays in the system.
  parentRequestId             String?                @map("parent_request_id") @db.Uuid
  parentRequest               ShopperRequest?        @relation("ShopperRequestParent", fields: [parentRequestId], references: [id], onDelete: SetNull)
  childRequests               ShopperRequest[]       @relation("ShopperRequestParent")

  // Buyer identity (no User row — magic-link only)
  buyerEmail                  String                 @map("buyer_email")
  buyerName                   String?                @map("buyer_name")
  // Migration 0023 — required for NEW requests at the Zod layer; nullable
  // here so the column doesn't require a backfill of historical rows.
  buyerPhone                  String?                @map("buyer_phone")

  // Migration 0023 — payment rail. Server-derived at intake from
  // items_subtotal vs the `shopper_wire_threshold_cents` config row. We
  // do NOT trust the client to pick.
  paymentMethod               ShopperPaymentMethod   @default(STRIPE) @map("payment_method")

  // Migration 0023 — ID-verification packet. Only meaningful when
  // paymentMethod = WIRE. Status is NONE by default for STRIPE-track
  // requests; the buyer never uploads anything.
  idVerificationStatus        ShopperIdVerificationStatus @default(NONE) @map("id_verification_status")
  idDocumentUrl               String?                @map("id_document_url")
  idSelfieUrl                 String?                @map("id_selfie_url")
  idRejectionReason           String?                @map("id_rejection_reason")
  idVerifiedAt                DateTime?              @map("id_verified_at")
  idVerifiedById              String?                @map("id_verified_by") @db.Uuid
  idVerifiedBy                User?                  @relation("ShopperIdVerifier", fields: [idVerifiedById], references: [id], onDelete: SetNull)

  // Migration 0023 — wire-transfer proof packet. Buyer uploads after we
  // send the quote; admin confirms once the bank receipt matches our
  // statement.
  wireProofUrl                String?                @map("wire_proof_url")
  wireProofUploadedAt         DateTime?              @map("wire_proof_uploaded_at")
  wireConfirmedAt             DateTime?              @map("wire_confirmed_at")
  wireConfirmedById           String?                @map("wire_confirmed_by") @db.Uuid
  wireConfirmedBy             User?                  @relation("ShopperWireConfirmer", fields: [wireConfirmedById], references: [id], onDelete: SetNull)

  // Migration 0026 — per-request bank instructions chosen by the admin
  // at ID-approval time. Falls back to the global
  // `shopper_bank_instructions` config row when null. Shape:
  //   { beneficiaryName?, bankName?, accountNumber, routingNumber?,
  //     swift?, iban?, memo? }
  wireBankInstructions        Json?                  @map("wire_bank_instructions")

  // Migration 0027 — shipping-invoice payment cycle. When setShipping
  // persists a non-zero freight cost, we create a Stripe Checkout
  // session and persist the session/intent id + the pay link here.
  // shipping_paid_at is stamped by the Stripe webhook when the buyer
  // pays; the downstream actions (warehouse delivery, ship, release,
  // mark-picked-up) refuse until it's set OR shipping_cost_cents is
  // zero (BUYER_FREIGHT / PICKUP).
  shippingInvoiceSessionId    String?                @map("shipping_invoice_session_id")
  shippingInvoiceIntentId     String?                @map("shipping_invoice_intent_id")
  shippingInvoiceUrl          String?                @map("shipping_invoice_url")
  shippingPaidAt              DateTime?              @map("shipping_paid_at")

  // Shipping (optional at intake, captured later in chat if missing)
  shippingAddress             Json?                  @map("shipping_address")
  shippingMethod              ShopperShippingMethod? @map("shipping_method")
  trackingNumber              String?                @map("tracking_number")
  carrier                     String?
  shippedAt                   DateTime?              @map("shipped_at")
  deliveredAt                 DateTime?              @map("delivered_at")

  // Migration 0025 — method-specific extras. All nullable; only relevant
  // for one method each (buyerLabelUrl ↔ BUYER_FREIGHT, pickupName +
  // pickupScheduledAt + pickupCompletedAt ↔ PICKUP).
  buyerLabelUrl               String?                @map("buyer_label_url")
  pickupName                  String?                @map("pickup_name")
  pickupScheduledAt           DateTime?              @map("pickup_scheduled_at")
  pickupCompletedAt           DateTime?              @map("pickup_completed_at")

  // Money — intake payment (sum of buyer's estimates + commission + tax)
  itemsSubtotalCents          Int                    @map("items_subtotal_cents")
  commissionRateBps           Int                    @map("commission_rate_bps")
  commissionCents             Int                    @map("commission_cents")
  // Migration 0013 — U.S. sales tax. Rate snapshot + estimated cents at
  // intake; actual cents captured by admin during procurement.
  estimatedTaxRateBps         Int                    @map("estimated_tax_rate_bps")
  estimatedTaxCents           Int                    @map("estimated_tax_cents")
  actualTaxCents              Int?                   @map("actual_tax_cents")
  // Migration 0014 — which state's tax rate was applied. Audit snapshot;
  // typically the warehouse state for PLATFORM_FREIGHT, the buyer's
  // forwarder state for BUYER_FORWARDER.
  effectiveTaxState           String?                @map("effective_tax_state")
  intakeTotalCents            Int                    @map("intake_total_cents")
  intakeStripeSessionId       String?                @map("intake_stripe_session_id")
  intakeStripeIntentId        String?                @map("intake_stripe_intent_id")
  intakePaidAt                DateTime?              @map("intake_paid_at")

  // Money — reconciliation (after admin procures, knows actuals + shipping)
  itemsActualSubtotalCents    Int?                   @map("items_actual_subtotal_cents")
  shippingCostCents           Int?                   @map("shipping_cost_cents")
  // Migration 0017 — freight rate snapshot + system-calculated cost. Lets
  // the receipt show "weight × rate = calc · charged X" so the buyer sees
  // exactly how the shipping number was reached. Both nullable to keep
  // rows from before this migration valid.
  freightRateCentsPerLb       Int?                   @map("freight_rate_cents_per_lb")
  shippingCalculatedCents     Int?                   @map("shipping_calculated_cents")
  // Signed: positive = buyer owes additional, negative = admin refunds, zero = no action.
  followupAmountCents         Int?                   @map("followup_amount_cents")
  followupStripeSessionId     String?                @map("followup_stripe_session_id")
  followupStripeIntentId      String?                @map("followup_stripe_intent_id")
  // Refund issued because actuals came in UNDER estimate (negative-followup branch).
  followupStripeRefundId      String?                @map("followup_stripe_refund_id")
  followupResolvedAt          DateTime?              @map("followup_resolved_at")

  // Refunds issued at cancel time. Migration 0012. Distinct from
  // followupStripeRefundId so we don't conflate "actuals came in cheaper"
  // with "we cancelled the whole order".
  cancelIntakeRefundId        String?                @map("cancel_intake_refund_id")
  cancelFollowupRefundId      String?                @map("cancel_followup_refund_id")

  // Migration 0016 — packed parcel dimensions + total weight, captured at
  // pack time. Drives carrier rate accuracy and (eventually) EasyPost
  // auto-quote. All nullable until admin enters them.
  parcelLengthIn              Float?                 @map("parcel_length_in")
  parcelWidthIn               Float?                 @map("parcel_width_in")
  parcelHeightIn              Float?                 @map("parcel_height_in")
  parcelWeightOz              Float?                 @map("parcel_weight_oz")

  // State
  status                      ShopperRequestStatus   @default(AWAITING_INTAKE_PAYMENT)
  assignedAdminId             String?                @map("assigned_admin_id") @db.Uuid
  assignedAdmin               User?                  @relation("ShopperAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  internalNotes               String?                @map("internal_notes")

  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")

  lines                       ShopperRequestLine[]
  messages                    ShopperMessage[]
  accessTokens                ShopperAccessToken[]
  // Migration 0019 — every shopper request emits 2-3 ledger rows (items,
  // commission, shipping) so admin Finance can show every dollar flow.
  ledgerEntries               LedgerEntry[]          @relation("ShopperRequestLedger")

  @@index([buyerEmail, createdAt])
  @@index([status, createdAt])
  @@index([assignedAdminId, status])
  @@index([effectiveTaxState])
  @@index([parentRequestId])
  @@map("shopper_requests")
}

model ShopperRequestLine {
  id                       String         @id @default(uuid()) @db.Uuid
  requestId                String         @map("request_id") @db.Uuid
  request                  ShopperRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productUrl               String         @map("product_url")
  productTitle             String?        @map("product_title")
  productNotes             String?        @map("product_notes")
  quantity                 Int

  estimatedUnitPriceCents  Int            @map("estimated_unit_price_cents")
  actualUnitPriceCents     Int?           @map("actual_unit_price_cents")

  // Migration 0016 — actual weight per line, captured when items arrive.
  // Float because warehouse scales report fractional ounces.
  actualWeightOz           Float?         @map("actual_weight_oz")

  procurementStatus        String?        @map("procurement_status")
  procurementNotes         String?        @map("procurement_notes")

  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  @@index([requestId])
  @@map("shopper_request_lines")
}

model ShopperMessage {
  id              String               @id @default(uuid()) @db.Uuid
  requestId       String               @map("request_id") @db.Uuid
  request         ShopperRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  sender          ShopperMessageSender
  // Non-null for ADMIN messages, null for BUYER (CHECK constraint enforces).
  senderUserId    String?              @map("sender_user_id") @db.Uuid
  senderUser      User?                @relation("ShopperMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  body            String
  attachmentUrls  String[]             @map("attachment_urls")

  readByBuyerAt   DateTime?            @map("read_by_buyer_at")
  readByAdminAt   DateTime?            @map("read_by_admin_at")

  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("shopper_messages")
}

model ShopperAccessToken {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  request     ShopperRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  tokenHash   String         @unique @map("token_hash")
  expiresAt   DateTime       @map("expires_at")
  lastUsedAt  DateTime?      @map("last_used_at")
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@map("shopper_access_tokens")
}

// =============================================================================
// Marketing — Pricing Guide leads
// =============================================================================

/// Lead-capture row for the public /pricing page "Get Our Full Price Guide"
/// form. We email the visitor the PDF and keep a record so sales can follow
/// up, finance can quantify funnel quality, and we can rate-limit duplicate
/// requests from the same email. Independent of the user/vendor tables —
/// these are pre-conversion prospects, not authenticated accounts.
model PricingGuideLead {
  id            String   @id @default(uuid()) @db.Uuid
  businessName  String   @map("business_name")
  email         String
  /// ISO 3166-1 alpha-2 country code captured at submit time.
  country       String   @db.VarChar(2)
  /// Source IP (when available) — useful for fraud / spam triage.
  /// Stored truncated (Cloudflare's CF-Connecting-IP).
  sourceIp      String?  @map("source_ip")
  /// User agent at submit time — same triage rationale as sourceIp.
  userAgent     String?  @map("user_agent") @db.Text
  /// True once the PDF email has been queued/sent successfully.
  emailSentAt   DateTime? @map("email_sent_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("pricing_guide_leads")
}
